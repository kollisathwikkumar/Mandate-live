# Names only. Supply real non-secret values through the process environment and secrets through the platform.
# Optional trusted CA PEM path; omit only when the provider cert verifies via Node trusted roots.
DATABASE_SSL_CA_PATH=
DATABASE_URL=
MANDATE_JWT_ISSUER=
MANDATE_JWT_JWKS_URL=
MANDATE_JWT_AUDIENCE=
MANDATE_RATE_LIMIT_HMAC_KEY=
MANDATE_CORS_ALLOWED_ORIGINS=
HOST=0.0.0.0
PORT=
NODE_ENV=production

# Optional verified chain integration. Do not fill from stale/local deployment examples.
MANDATE_EVM_RPC_URLS=
MANDATE_SAFE_SINGLETONS=
# Exact deployed runtime-code hashes, keyed by chain ID and lower-case contract address.
# Populate only from reviewed build artifacts and independently verified deployments; absent entries fail closed.
MANDATE_TRUSTED_RUNTIME_CODE_HASHES=
MANDATE_CHAIN_CONFIRMATIONS=
MANDATE_INDEXER_START_BLOCKS=
MANDATE_INDEXER_CONFIRMATIONS=

# Optional integrations. Secret values must be injected at runtime.
MANDATE_AUDIT_SIGNING_SECRET_ARN=
MANDATE_AUDIT_ANCHOR_BUCKET=
MANDATE_INVITATION_TOKEN_ENCRYPTION_KEY_HEX=
MANDATE_INVITATION_EMAIL_FROM=
MANDATE_INVITATION_ACCEPT_URL=
